{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RoadPilotHQ/RoadPilot-Telemetry/blob/main/schemas/telemetry-frame-v1.schema.json",
  "title": "RoadPilot telemetry frame v1 (draft)",
  "type": "object",
  "required": ["protocol", "schemaVersion", "sequence", "game", "pluginState", "values"],
  "properties": {
    "protocol": { "const": "roadpilot.telemetry" },
    "schemaVersion": { "const": 1 },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonically increasing per plugin session; capped at JavaScript's exact integer limit."
    },
    "game": { "enum": ["ets2", "ats"] },
    "pluginState": { "enum": ["running", "paused"] },
    "values": {
      "type": "object",
      "properties": {
        "speedMps": {
          "type": ["number", "null"],
          "description": "Truck speed in meters per second. Negative values indicate reverse."
        },
        "engineRpm": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Engine revolutions per minute."
        },
        "gear": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 2147483647,
          "description": "Positive is forward, zero is neutral, negative is reverse."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
